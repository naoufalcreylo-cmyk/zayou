{%- comment -%} Close-ups from the real product photography, each linked to the product it shows. The first tile is shown large. {%- endcomment -%}
<section class="section details" style="--pad-top: {{ section.settings.pad_top }}px; --pad-bottom: {{ section.settings.pad_bottom }}px;" aria-labelledby="details-title-{{ section.id }}">
  <div class="container">
    <div class="details__head">
      <h2 class="h-display lower details__title" id="details-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="details__lede muted">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="details__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign img = block.settings.image
          if img == blank and p != blank
            assign idx = block.settings.image_position | minus: 1
            assign img = p.media[idx].preview_image | default: p.featured_image
          endif
          assign url = block.settings.link | default: p.url
        -%}
        <li class="detail{% if forloop.first %} detail--lead{% endif %}" {{ block.shopify_attributes }}>
          <a class="detail__link" href="{{ url }}">
            <span class="media media--tile media--photo">
              {%- if img != blank -%}
                {%- if forloop.first -%}{%- assign w = '(min-width: 990px) 46vw, 92vw' -%}{%- else -%}{%- assign w = '(min-width: 990px) 22vw, 45vw' -%}{%- endif -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: w, alt: block.settings.image_alt }}
              {%- endif -%}
            </span>
            <span class="detail__caption">
              <span class="detail__title">{{ block.settings.caption }}</span>
              {%- if p != blank -%}<span class="small muted">{{ p.title }}</span>{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Détails",
  "class": "section-details",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "dans le détail." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "range", "id": "pad_top", "label": "Marge haute", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Détail",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "range", "id": "image_position", "label": "Numéro de la photo (gros plan)", "min": 1, "max": 10, "step": 1, "default": 2 },
        { "type": "image_picker", "id": "image", "label": "Ou : image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
        { "type": "text", "id": "caption", "label": "Légende", "info": "Uniquement ce que la photo ou la fiche produit montre." },
        { "type": "url", "id": "link", "label": "Lien (par défaut : le produit)" }
      ]
    }
  ],
  "presets": [{ "name": "Détails", "blocks": [{ "type": "detail" }, { "type": "detail" }, { "type": "detail" }] }]
}
{% endschema %}
