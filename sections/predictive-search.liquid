{%- liquid
  assign res = predictive_search.resources
  assign total = res.products.size | plus: res.collections.size | plus: res.queries.size | plus: res.articles.size
-%}
{%- if predictive_search.performed -%}
  <div data-predictive-content data-count="{{ total }}">
    {%- if total > 0 -%}
      <div class="predictive__cols">
        <div>
          {%- if res.queries.size > 0 -%}
            <p class="predictive__title" id="ps-queries">{{ 'search.suggestions' | t }}</p>
            <ul class="predictive__list" role="listbox" aria-labelledby="ps-queries">
              {%- for q in res.queries -%}
                <li role="presentation"><a href="{{ q.url }}" role="option" aria-selected="false" data-predictive-item id="ps-q-{{ forloop.index }}">{{ q.styled_text }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if res.collections.size > 0 -%}
            <p class="predictive__title" style="margin-top: 20px" id="ps-cols">{{ 'search.collections' | t }}</p>
            <ul class="predictive__list" role="listbox" aria-labelledby="ps-cols">
              {%- for c in res.collections -%}
                <li role="presentation"><a href="{{ c.url }}" role="option" aria-selected="false" data-predictive-item id="ps-c-{{ forloop.index }}">{{ c.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if res.articles.size > 0 -%}
            <p class="predictive__title" style="margin-top: 20px" id="ps-arts">{{ 'search.articles' | t }}</p>
            <ul class="predictive__list" role="listbox" aria-labelledby="ps-arts">
              {%- for a in res.articles limit: 3 -%}
                <li role="presentation"><a href="{{ a.url }}" role="option" aria-selected="false" data-predictive-item id="ps-a-{{ forloop.index }}">{{ a.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        <div>
          {%- if res.products.size > 0 -%}
            <p class="predictive__title" id="ps-products">{{ 'search.products' | t }}</p>
            <ul class="predictive__products" role="listbox" aria-labelledby="ps-products" style="list-style: none; padding: 0; margin: 0;">
              {%- for product in res.products limit: 8 -%}
                <li role="presentation">
                  <a class="predictive__product" href="{{ product.url }}" role="option" aria-selected="false" data-predictive-item id="ps-p-{{ forloop.index }}">
                    <div class="media media--packshot">
                      {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 360', sizes: '(min-width: 750px) 20vw, 45vw', alt: '' }}{%- endif -%}
                    </div>
                    <span>{{ product.title }}</span>
                    {%- render 'price', product: product, compact: true -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
      <a class="btn btn--ghost predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" data-predictive-item>{{ 'search.view_all_simple' | t }}</a>
    {%- else -%}
      <div class="empty-state" style="padding-block: 8px 16px;">
        <p>{%- assign terms_safe = predictive_search.terms | escape -%}{{ 'search.no_results' | t: terms: terms_safe }}</p>
        <p class="muted small">{{ 'search.no_results_hint' | t }}</p>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Recherche prédictive",
  "settings": []
}
{% endschema %}
