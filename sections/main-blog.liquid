<div class="container">
  <header class="page-head"><h1 class="h1 lower">{{ blog.title }}</h1></header>
  {%- paginate blog.articles by 12 -%}
    <ul class="articles page-body" role="list" style="list-style:none;padding:0">
      {%- for article in blog.articles -%}
        <li>
          <a class="article-card" href="{{ article.url }}">
            <div class="media media--landscape">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 750px) 31vw, 92vw', alt: article.image.alt }}{%- endif -%}</div>
            <span class="small muted">{{ article.published_at | time_tag: format: 'date' }}</span>
            <span class="article-card__title">{{ article.title }}</span>
            <span class="muted small">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
