{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.product != blank
    assign idx = section.settings.image_position | minus: 1
    assign img = section.settings.product.media[idx].preview_image | default: section.settings.product.featured_image
  endif
  assign img2 = section.settings.image_2
  if img2 == blank and section.settings.product_2 != blank
    assign idx2 = section.settings.image_position_2 | minus: 1
    assign img2 = section.settings.product_2.media[idx2].preview_image | default: section.settings.product_2.featured_image
  endif
  assign img_mobile = section.settings.image_mobile | default: img
  assign layout = section.settings.layout
  if layout == 'diptych' and img2 == blank
    assign layout = 'cover'
  endif
-%}
<section class="hero hero--{{ layout }}" aria-labelledby="hero-title-{{ section.id }}">
  {%- if layout == 'diptych' -%}
    <div class="hero__diptych">
      <a class="hero__panel" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true">
        {%- if img_mobile != img -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
            {{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image_alt }}
          </picture>
        {%- else -%}
          {{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image_alt }}
        {%- endif -%}
      </a>
      <a class="hero__panel hero__panel--second" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true">
        {{ img2 | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '50vw', widths: '600, 900, 1200, 1400', alt: section.settings.image_alt_2 }}
      </a>
    </div>
  {%- else -%}
    <div class="hero__media{% if layout == 'split' %} media media--packshot{% endif %}">
      {%- if img != blank -%}
        {%- if img_mobile != img -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
            {{ img | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 60vw, 100vw', widths: '750, 1100, 1500, 2000', alt: section.settings.image_alt }}
          </picture>
        {%- else -%}
          {{ img | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 60vw, 100vw', widths: '750, 1100, 1500, 2000', alt: section.settings.image_alt }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="hero__text container">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h-display{% if section.settings.lowercase %} lower{% endif %}" id="hero-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="hero__lede">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero__ctas">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--lg{% if layout != 'split' %} btn--light{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn--lg btn--ghost" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Mise en page", "options": [ { "value": "diptych", "label": "Campagne : deux photos" }, { "value": "split", "label": "Photo produit + texte" }, { "value": "cover", "label": "Photo plein cadre" } ], "default": "diptych", "info": "« Deux photos » et « Plein cadre » sont faits pour des photos d'ambiance ; « Photo produit » pour les photos sur fond blanc." },
    { "type": "image_picker", "id": "image", "label": "Image 1" },
    { "type": "product", "id": "product", "label": "Ou : photo d'un produit (image 1)", "info": "Utilisé si aucune image n'est choisie." },
    { "type": "range", "id": "image_position", "label": "Numéro de la photo (image 1)", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif (image 1)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (campagne)" },
    { "type": "product", "id": "product_2", "label": "Ou : photo d'un produit (image 2)" },
    { "type": "range", "id": "image_position_2", "label": "Numéro de la photo (image 2)", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "text", "id": "image_alt_2", "label": "Texte alternatif (image 2)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (facultatif)" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "bien chaussé, tous les jours." },
    { "type": "checkbox", "id": "lowercase", "label": "Titre en minuscules (comme le logo)", "default": true },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Découvrir" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Bouton secondaire" },
    { "type": "url", "id": "button2_link", "label": "Lien du bouton secondaire" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
