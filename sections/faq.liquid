{%- comment -%} Questions & answers (only verified answers), with FAQPage structured data. {%- endcomment -%}
<section class="section faq" id="{{ section.settings.anchor | default: section.id }}" style="--pad-top: {{ section.settings.pad_top }}px; --pad-bottom: {{ section.settings.pad_bottom }}px;" aria-labelledby="faq-title-{{ section.id }}">
  <div class="container faq__grid">
    <div class="faq__head">
      <h2 class="h2 lower" id="faq-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="acc" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="acc__title">{{ block.settings.question }}{% render 'icon', name: 'plus', class: 'icon--sm' %}</summary>
          <div class="acc__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "class": "section-faq",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "questions fréquentes" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "range", "id": "pad_top", "label": "Marge haute", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "info": "Uniquement des réponses vérifiées." }
    ] }
  ],
  "presets": [{ "name": "Questions fréquentes", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
