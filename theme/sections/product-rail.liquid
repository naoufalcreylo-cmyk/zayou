{%- liquid
  assign limit = section.settings.limit
  assign from_list = false
  if section.settings.products != blank and section.settings.products.size > 0
    assign from_list = true
  endif
  assign c = section.settings.collection
  assign link = section.settings.link | default: c.url
-%}
<section class="section product-rail" style="--pad-top: {{ section.settings.pad_top }}px; --pad-bottom: {{ section.settings.pad_bottom }}px;" aria-labelledby="rail-title-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2 lower" id="rail-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div class="section-head__aside">
        {%- if section.settings.link_label != blank and link != blank -%}
          <a class="link-arrow small" href="{{ link }}">{{ section.settings.link_label }}{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        {%- endif -%}
        {%- unless section.settings.grid_desktop -%}
          <div class="rail-nav" data-rail-nav="rail-{{ section.id }}">
            <button type="button" data-rail-prev aria-label="{{ 'accessibility.scroll_left' | t }}" disabled>{% render 'icon', name: 'arrow-left', class: 'icon--sm' %}</button>
            <button type="button" data-rail-next aria-label="{{ 'accessibility.scroll_right' | t }}">{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
          </div>
        {%- endunless -%}
      </div>
    </div>
    <ul class="rail{% if section.settings.grid_desktop %} rail--grid-desktop{% endif %} product-rail__list" id="rail-{{ section.id }}" role="list" style="--cols-desktop: {{ section.settings.cols_desktop }}">
      {%- if from_list -%}
        {%- for product in section.settings.products limit: limit -%}
          <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 23vw, (min-width: 750px) 40vw, 72vw' %}</li>
        {%- endfor -%}
      {%- elsif c != blank -%}
        {%- assign shown = 0 -%}
        {%- for product in c.products -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- if section.settings.available_only and product.available == false -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 23vw, (min-width: 750px) 40vw, 72vw' %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li><div class="media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Sélection de produits",
  "class": "section-product-rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "la sélection" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "product_list", "id": "products", "label": "Produits choisis", "limit": 16, "info": "Prioritaire sur la collection." },
    { "type": "collection", "id": "collection", "label": "Ou : collection" },
    { "type": "checkbox", "id": "available_only", "label": "Uniquement les produits disponibles (collection)", "default": true },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "grid_desktop", "label": "Grille sur ordinateur (au lieu d'un défilement)", "default": false },
    { "type": "select", "id": "cols_desktop", "label": "Colonnes (grille)", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Tout voir" },
    { "type": "url", "id": "link", "label": "Lien", "info": "Par défaut : la collection choisie." },
    { "type": "range", "id": "pad_top", "label": "Marge haute", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Sélection de produits" }]
}
{% endschema %}
