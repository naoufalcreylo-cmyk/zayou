{%- assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
<div class="container">
  <header class="page-head"><h1 class="h1 lower">{{ page.title }}</h1></header>
  <div class="contact-grid page-body">
    <div class="contact-direct">
      {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
      <p class="eyebrow muted">{{ 'contact.or' | t }}</p>
      {%- if settings.whatsapp_number != blank -%}
        <a class="btn btn--ghost" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', class: 'icon--sm' %} {{ 'general.whatsapp' | t }} · {{ settings.whatsapp_number }}</a>
      {%- endif -%}
      {%- if settings.phone != blank -%}
        <a class="btn btn--ghost" href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}">{% render 'icon', name: 'phone', class: 'icon--sm' %} {{ settings.phone }}</a>
      {%- endif -%}
    </div>
    {%- form 'contact', id: 'contact-form', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input class="input" id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="c-email">{{ 'contact.email' | t }} *</label><input class="input" id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="c-phone">{{ 'contact.phone' | t }}</label><input class="input" id="c-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label for="c-msg">{{ 'contact.message' | t }}</label><textarea class="textarea" id="c-msg" name="contact[body]">{{ form.body }}</textarea></div>
      <button type="submit" class="btn btn--lg">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Contact", "settings": [] }
{% endschema %}
