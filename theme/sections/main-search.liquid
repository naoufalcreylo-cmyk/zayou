{%- liquid
  assign per_page = section.settings.per_page
  assign terms_safe = search.terms | escape
-%}
<div class="collection search-page" data-collection data-section-id="{{ section.id }}">
  <div class="container search-head">
    <h1 class="h1 lower">{%- if search.performed -%}{{ 'search.results_for' | t: terms: terms_safe }}{%- else -%}{{ 'search.title' | t }}{%- endif -%}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form">
      <label for="search-page-input" class="visually-hidden">{{ 'search.title' | t }}</label>
      <input id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="icon-btn" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by per_page -%}
      <div data-collection-results>
        {%- if search.results_count > 0 or search.filters.size > 0 -%}
          {%- render 'facets', results: search, results_count: search.results_count, base_url: routes.search_url, section_id: section.id -%}
        {%- endif -%}
        <div class="container collection__body">
          {%- if search.results_count > 0 -%}
            <ul class="grid product-grid" role="list" data-product-grid>
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card', product: item %}
                    {%- else -%}
                      <a class="article-card" href="{{ item.url }}">
                        <div class="media">{%- if item.image -%}{{ item.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 23vw, 46vw', alt: '' }}{%- endif -%}</div>
                        <span class="article-card__title">{{ item.title }}</span>
                      </a>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- if paginate.next -%}
              <div class="collection__more" data-load-more-wrap>
                {%- assign shown = paginate.current_offset | plus: search.results.size -%}
                <p class="small muted" data-shown-count>{{ 'collections.showing' | t: shown: shown, total: paginate.items }}</p>
                <a class="btn btn--ghost" href="{{ paginate.next.url }}" data-load-more>{{ 'collections.load_more' | t }}</a>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="empty-state">
              <p class="h3">{{ 'search.no_results' | t: terms: terms_safe }}</p>
              <p class="muted">{{ 'search.no_results_hint' | t }}</p>
              {% render 'menu-chips' %}
            </div>
            {%- if section.settings.fallback_collection != blank -%}
              <h2 class="h2 lower" style="margin-bottom: 24px;">{{ section.settings.fallback_heading }}</h2>
              <ul class="grid product-grid" role="list">
                {%- for product in section.settings.fallback_collection.products limit: 4 -%}
                  <li>{% render 'product-card', product: product %}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  {%- else -%}
    <div class="container empty-state">
      <p>{{ 'search.empty_prompt' | t }}</p>
      {% render 'menu-chips' %}
    </div>
  {%- endif -%}
</div>

<p class="visually-hidden" aria-live="polite" data-results-live></p>
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Résultats de recherche",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Résultats par page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "collection", "id": "fallback_collection", "label": "Produits proposés si aucun résultat" },
    { "type": "text", "id": "fallback_heading", "label": "Titre des produits proposés", "default": "à découvrir" }
  ]
}
{% endschema %}
