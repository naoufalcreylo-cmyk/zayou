{%- comment -%} Numbered advice or steps, each with an optional square image (product photo) and link. {%- endcomment -%}
<section class="section steps{% if section.settings.surface %} steps--surface{% endif %}" id="{{ section.settings.anchor | default: section.id }}" style="--pad-top: {{ section.settings.pad_top }}px; --pad-bottom: {{ section.settings.pad_bottom }}px;" aria-labelledby="steps-title-{{ section.id }}">
  <div class="container">
    <div class="steps__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2 lower" id="steps-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="muted steps__lede">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ol class="steps__list{% if section.settings.columns %} steps__list--cols{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          if img == blank and block.settings.product != blank
            assign idx = block.settings.image_position | minus: 1
            assign img = block.settings.product.media[idx].preview_image | default: block.settings.product.featured_image
          endif
        -%}
        <li class="step{% if img != blank %} step--image{% endif %}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            <a class="media media--tile media--photo step__media" href="{{ block.settings.link | default: block.settings.product.url }}" tabindex="-1" aria-hidden="true">
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 990px) 20vw, 40vw', alt: '' }}
            </a>
          {%- endif -%}
          <div class="step__body">
            <span class="step__index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="step__title">{{ block.settings.title }}</h3>
            <div class="step__text">{{ block.settings.text }}</div>
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="link-arrow small" href="{{ block.settings.link }}">{{ block.settings.link_label }}{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Conseils / étapes",
  "class": "section-steps",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (ex. mesurer)" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "en pratique" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "columns", "label": "Disposition en colonnes", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Fond grège", "default": false },
    { "type": "range", "id": "pad_top", "label": "Marge haute", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "step", "name": "Étape", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
      { "type": "richtext", "id": "text", "label": "Texte" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "product", "id": "product", "label": "Ou : photo d'un produit" },
      { "type": "range", "id": "image_position", "label": "Numéro de la photo", "min": 1, "max": 10, "step": 1, "default": 1 },
      { "type": "text", "id": "link_label", "label": "Texte du lien" },
      { "type": "url", "id": "link", "label": "Lien" }
    ] }
  ],
  "presets": [{ "name": "Conseils / étapes", "blocks": [{ "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
