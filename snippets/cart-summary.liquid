{%- comment -%} Totals + checkout, shared by drawer and page. The checkout button is a standard name="checkout" submit so ordering apps can attach to the cart form. {%- endcomment -%}
<div class="cart-totals">
  {%- for discount in cart.cart_level_discount_applications -%}
    <div class="cart-totals__row small"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span></div>
  {%- endfor -%}
  <div class="cart-totals__row cart-totals__row--total">
    <span>{{ 'cart.subtotal' | t }}</span>
    <span data-cart-total>{{ cart.total_price | money_without_trailing_zeros }}</span>
  </div>
  <p class="small muted">{{ 'cart.taxes_shipping' | t }}</p>
</div>
<form action="{{ routes.cart_url }}" method="post" id="{{ form_id | default: 'cart-form' }}" novalidate>
  <button type="submit" name="checkout" class="btn btn--block btn--lg">{{ 'cart.checkout' | t }}</button>
</form>
{%- if settings.cart_note != blank -%}
  <p class="cart-note">{{ settings.cart_note }}</p>
{%- endif -%}
