{%- if request.page_type == 'index' -%}
  {%- liquid
    assign same_as = ''
    assign social_keys = 'social_instagram,social_facebook,social_tiktok,social_youtube' | split: ','
    for key in social_keys
      if settings[key] != blank
        assign same_as = same_as | append: settings[key] | append: '|'
      endif
    endfor
    assign same_as = same_as | split: '|'
  -%}
  {%- capture search_target -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }}
      {%- if settings.logo != blank -%},
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if same_as.size > 0 -%},
        "sameAs": {{ same_as | json }}
      {%- endif %}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}
