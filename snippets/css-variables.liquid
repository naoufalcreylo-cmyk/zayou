{%- liquid
  assign heading_weight = settings.heading_weight | default: 500
-%}
<style>
  @font-face {
    font-family: 'Instrument Sans';
    src: url('{{ 'InstrumentSans.woff2' | asset_url }}') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Instrument Sans';
    src: url('{{ 'InstrumentSans-ext.woff2' | asset_url }}') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  :root {
    --ink: {{ settings.color_ink }};
    --bg: {{ settings.color_background }};
    --surface: {{ settings.color_surface }};
    --muted: {{ settings.color_muted }};
    --line: {{ settings.color_line }};
    --ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
    --fs-base: {{ settings.type_base_size | default: 15 }}px;
    --heading-weight: {{ heading_weight }};
    --logo-w: {{ settings.logo_width_mobile | default: 84 }}px;
    --logo-w-desktop: {{ settings.logo_width | default: 112 }}px;
  }
</style>
